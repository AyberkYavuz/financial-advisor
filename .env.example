# LLM provider: deepseek | openai | anthropic | gemini
LLM_PROVIDER=deepseek

# Cloud provider keys. Leave blank for any vendor you do not call.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Model per provider. Leave blank to use the built-in default:
#   openai    -> gpt-4o
#   anthropic -> claude-sonnet-4-5
#   gemini    -> gemini-2.0-flash
#   deepseek  -> deepseek-v4-pro
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=
DEEPSEEK_MODEL=
